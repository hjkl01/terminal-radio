FROM eclipse-temurin:17-jdk-jammy

# Android / Gradle versions used by the project.
ARG GRADLE_VERSION=8.2
ARG ANDROID_SDK_URL=https://dl.google.com/android/repository/commandlinetools-linux-9477386_latest.zip
ARG ANDROID_BUILD_TOOLS_VERSION=33.0.0
ARG ANDROID_PLATFORM_VERSION=34

ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_SDK_ROOT=/opt/android-sdk
ENV GRADLE_HOME=/opt/gradle/gradle-${GRADLE_VERSION}
ENV PATH=/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:${GRADLE_HOME}/bin:${PATH}

# The Makefile guarantees that gradle-${GRADLE_VERSION}-bin.zip exists in the
# Docker build context. This keeps the Dockerfile compatible with Docker
# installations where BuildKit is disabled and avoids any Gradle download here.
COPY gradle-${GRADLE_VERSION}-bin.zip /tmp/gradle.zip

# Google only ships x86_64 Linux binaries for the Android SDK tools (aapt2,
# zipalign, aapt, ...). On arm64 hosts those binaries are executed through the
# qemu-user binfmt emulation that Docker/Colima installs, but the base image has
# no x86_64 runtime at all, which makes them fail with:
#
#   qemu-x86_64: Could not open '/lib64/ld-linux-x86-64.so.2'
#
# Installing the cross packages and exposing them at the paths the x86_64
# loader expects keeps the JVM/Gradle native to the host architecture while
# still letting the SDK tools run (emulated).
RUN if [ "$(uname -m)" != "x86_64" ]; then \
        apt-get update && \
        apt-get install -y --no-install-recommends \
            libc6-amd64-cross libgcc-s1-amd64-cross libstdc++6-amd64-cross && \
        rm -rf /var/lib/apt/lists/* && \
        mkdir -p /lib64 /lib/x86_64-linux-gnu && \
        ln -sf /usr/x86_64-linux-gnu/lib/ld-linux-x86-64.so.2 /lib64/ld-linux-x86-64.so.2 && \
        for lib in /usr/x86_64-linux-gnu/lib/*.so*; do \
            ln -sfn "$lib" "/lib/x86_64-linux-gnu/$(basename "$lib")"; \
        done; \
    fi

# Install the Android command-line tools, Android SDK and the exact Gradle
# version required by the project. Gradle itself is always supplied by the
# local ZIP prepared by the Makefile.
RUN apt-get update && \
    apt-get install -y --no-install-recommends curl unzip ca-certificates && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /opt/android-sdk/cmdline-tools /tmp/android-sdk /opt/gradle && \
    curl -fsSL "${ANDROID_SDK_URL}" -o /tmp/android-sdk/cmdline-tools.zip && \
    unzip -q /tmp/android-sdk/cmdline-tools.zip -d /tmp/android-sdk && \
    mv /tmp/android-sdk/cmdline-tools /opt/android-sdk/cmdline-tools/latest && \
    rm -rf /tmp/android-sdk && \
    yes | sdkmanager --licenses >/dev/null 2>&1 || true && \
    sdkmanager "platform-tools" "platforms;android-${ANDROID_PLATFORM_VERSION}" "build-tools;${ANDROID_BUILD_TOOLS_VERSION}" && \
    unzip -q /tmp/gradle.zip -d /opt/gradle && \
    rm -f /tmp/gradle.zip

WORKDIR /workspace/android

COPY android/gradle.properties /workspace/android/gradle.properties
COPY android/build.gradle.kts /workspace/android/build.gradle.kts
COPY android/settings.gradle.kts /workspace/android/settings.gradle.kts
COPY android/app/ /workspace/android/app/

# Use the Gradle installation already included in this image. Do not invoke
# ./gradlew here: Gradle Wrapper would read distributionUrl and try to download
# another Gradle ZIP even though Gradle 8.2 is already installed.
RUN gradle --version
